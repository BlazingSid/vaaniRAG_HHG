# Never commit real keys. Copy this file to .env for local development.
SARVAM_API_KEY=
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=msmarco_xi_multiview_v1
API_BEARER_TOKEN=change-me

# Fast mode returns the dataset's grounded answer. Generative mode is opt-in
# because a network LLM request is measured separately from the <200 ms path.
ENABLE_GENERATIVE_MODE=false
QUERY_DEADLINE_MS=200
MIN_GROUNDING_CONFIDENCE=0.30

# Set these in the hosted front end after deploying the Python service.
RAG_BACKEND_URL=http://localhost:8000
RAG_BACKEND_TOKEN=change-me
